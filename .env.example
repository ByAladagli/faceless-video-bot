# Copy to .env on the server; never commit real values.
BOT_TIMEZONE=Europe/Istanbul
PUBLISH_TIME=19:00
LOG_LEVEL=INFO

# Browser sessions contain sensitive login cookies; keep the directory private.
SELENIUM_PROFILE_DIR=/var/lib/faceless-video-bot/browser_profiles
SELENIUM_HEADLESS=0
SELENIUM_WAIT_SECONDS=25

# Set to a strong random secret only after authentication is implemented.
# APP_SECRET_KEY=replace-with-a-long-random-secret

# Multi-user production targets (not yet wired to current prototype).
# DATABASE_URL=postgresql+psycopg://faceless:CHANGE_ME@postgres:5432/faceless
# REDIS_URL=redis://redis:6379/0
